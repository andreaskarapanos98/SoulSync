PORT=4000
NODE_ENV=development

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=pk_test_Y29tcG9zZWQtZW11LTE3LmNsZXJrLmFjY291bnRzLmRldiQ

# Filled in when we wire up Mongo in the next step
MONGO_URI=

# Where Stripe Checkout redirects back to after payment.
CLIENT_URL=http://localhost:5173

# Stripe (coin purchases) — leave blank in dev; coin checkout returns a 503 until set.
# For local webhook testing: stripe listen --forward-to localhost:4000/api/v1/coins/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 (S3-compatible) — required, uploads have no local-disk fallback.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Firebase Admin SDK (push notifications) — base64 of the full service account JSON
# downloaded from Firebase Console > Project Settings > Service Accounts.
# e.g. base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_B64=
